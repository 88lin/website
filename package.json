{
  "name": "moling-website",
  "private": true,
  "version": "8.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:ssr && node scripts/prerender.mjs",
    "build:client": "tsc -b --noCheck && vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "preview": "vite preview",
    "chars": "node scripts/chars.mjs",
    "fonts": "npm run chars && python3 scripts/subset-fonts.py",
    "static": "node scripts/static.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.1.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lighthouse": "^12.8.2",
    "playwright": "^1.50.1",
    "sharp": "^0.34.2",
    "simple-icons": "^13.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
