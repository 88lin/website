    "@vitejs/plugin-react": "^4.3.4",
    "lighthouse": "^12.8.2",
    "playwright": "^1.50.1",
    "sharp": "^0.34.2",
    "simple-icons": "^13.21.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
